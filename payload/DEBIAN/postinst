#!/bin/sh
# Never fail package install because of optional cleanup steps.
set +e
ROOT="/var/jb"
MS="$ROOT/Library/MobileSubstrate/DynamicLibraries"
ETC="$ROOT/etc/changeinfoios"

for f in \
  "$MS/ChangeInfoIosMG.dylib" "$MS/ChangeInfoIosMG.plist" \
  "$MS/ChangeInfoIosCT.dylib" "$MS/ChangeInfoIosCT.plist"
do
  [ -e "$f" ] || continue
  chown root:wheel "$f" >/dev/null 2>&1
  case "$f" in
    *.dylib) chmod 0755 "$f" >/dev/null 2>&1 ;;
    *)       chmod 0644 "$f" >/dev/null 2>&1 ;;
  esac
done

mkdir -p "$ETC" >/dev/null 2>&1
chmod 0777 "$ETC" >/dev/null 2>&1

JBCTL=""
for c in "$ROOT/basebin/jbctl" "$ROOT/usr/bin/jbctl" /var/jb/basebin/jbctl; do
  if [ -x "$c" ]; then JBCTL="$c"; break; fi
done
if [ -n "$JBCTL" ] && [ -f "$ETC/cdhashes" ]; then
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    "$JBCTL" trustcache add "$h" >/dev/null 2>&1
  done < "$ETC/cdhashes"
fi

APP="$ROOT/Applications/Diso.app"
if [ -d "$APP" ]; then
  # Re-sign after binary UI patches (cdhash changes)
  for s in "$ROOT/usr/bin/ldid" /var/jb/usr/bin/ldid ldid; do
    if command -v "$s" >/dev/null 2>&1 || [ -x "$s" ]; then
      "$s" -S "$APP/Diso" >/dev/null 2>&1
      break
    fi
  done
  for u in "$ROOT/usr/bin/uicache" /var/jb/usr/bin/uicache uicache; do
    if command -v "$u" >/dev/null 2>&1; then
      "$u" -p "$APP" >/dev/null 2>&1
      break
    fi
    if [ -x "$u" ]; then
      "$u" -p "$APP" >/dev/null 2>&1
      break
    fi
  done
fi

exit 0
